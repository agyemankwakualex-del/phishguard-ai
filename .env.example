# Names only. PhishGuard reads the process environment. It does not load this file.
SECRET_KEY=
DATABASE_URL=
# Optional. One current public IPv4 of the Supabase pooler host, used only to
# skip Vercel glibc DNS when logs show Errno 16 in conninfo_attempts. Addresses
# rotate. Leave empty normally. Do not commit a value.
DATABASE_HOSTADDR=
GROQ_API_KEY=
# Optional. Leave empty to use openai/gpt-oss-20b. Do not commit a value.
GROQ_MODEL=
VIRUSTOTAL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
